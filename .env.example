# Configuration du PC Hôte (mode démo). Copier en .env (gitignoré) : cp .env.example .env
# Docker Compose lit automatiquement ce .env pour remplir les ${...} de compose.yaml.

# Adresse publique du PC Hôte : celle que tapent le navigateur et le PC Attaquant.
#  - démo (point d'accès mobile Windows RESILIENCE-G<n>) : 192.168.137.1
#  - travail sans point d'accès : l'IPv4 de la carte réseau du PC (ipconfig).
#    Jamais localhost : dans un conteneur, localhost désigne le conteneur lui-même.
# Tout changement impose : bash scripts/gen-lab-pki.sh, puis rebuild du frontend
# (les URL publiques sont figées dans le bundle Next.js au build).

# A la maison
PUBLIC_HOST=192.168.1.156
KEYCLOAK_DB_PASSWORD=ChangezMoi!
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ChangezMoiAussi!

vault_keycloak_db_password: "ChangezMoi!"
vault_keycloak_admin_user: "admin"
vault_keycloak_admin_password: "ChangezMoiAussi!"
