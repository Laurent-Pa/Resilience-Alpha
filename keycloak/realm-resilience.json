{
  "realm": "resilience",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      { "name": "client", "description": "Titulaire d'un compte" },
      { "name": "ops", "description": "Opérateur / supervision" },
      { "name": "prober", "description": "Sonde synthétique" }
    ]
  },
  "clients": [
    {
      "clientId": "web-pay",
      "name": "Front paiement",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://${PUBLIC_HOST:192.168.137.1}",
      "baseUrl": "/",
      "redirectUris": ["https://${PUBLIC_HOST:192.168.137.1}/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PUBLIC_HOST:192.168.137.1}/*##http://localhost:3000/*##http://127.0.0.1:3000/*"
      },
      "protocolMappers": [
        {
          "name": "aud-payment-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "payment-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "web-ops",
      "name": "Dashboard ops",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://${PUBLIC_HOST:192.168.137.1}",
      "baseUrl": "/admin/",
      "redirectUris": ["https://${PUBLIC_HOST:192.168.137.1}/admin/*", "http://localhost:3000/admin/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PUBLIC_HOST:192.168.137.1}/admin/*##http://localhost:3000/admin/*"
      },
      "protocolMappers": [
        {
          "name": "aud-payment-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "payment-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "aud-remediation-engine",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "remediation-engine", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "prober",
      "name": "Sonde synthétique",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROBER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "aud-payment-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "payment-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "remediation-engine",
      "name": "Moteur de remédiation",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${REMEDIATION_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "aud-payment-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "payment-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "payment-api",
      "name": "API paiement (audience)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "email": "alice@resilience.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Test",
      "enabled": true,
      "realmRoles": ["client", "default-roles-resilience"],
      "credentials": [{ "type": "password", "value": "${TEST_USERS_PASSWORD}", "temporary": false }]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "bob",
      "email": "bob@resilience.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Test",
      "enabled": true,
      "realmRoles": ["client", "default-roles-resilience"],
      "credentials": [{ "type": "password", "value": "${TEST_USERS_PASSWORD}", "temporary": false }]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "carol",
      "email": "carol@resilience.test",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Test",
      "enabled": true,
      "realmRoles": ["client", "default-roles-resilience"],
      "credentials": [{ "type": "password", "value": "${TEST_USERS_PASSWORD}", "temporary": false }]
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "username": "operator",
      "email": "operator@resilience.test",
      "emailVerified": true,
      "firstName": "Operator",
      "lastName": "Test",
      "enabled": true,
      "realmRoles": ["ops", "default-roles-resilience"],
