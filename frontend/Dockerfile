FROM node:20-alpine AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_ADMIN_API_BASE_URL
ENV NEXT_PUBLIC_ADMIN_API_BASE_URL=$NEXT_PUBLIC_ADMIN_API_BASE_URL
# Bypass de dev pour le back-office (TODO: retirer une fois Keycloak branché, cf. AdminAuthContext.tsx)
ARG NEXT_PUBLIC_ADMIN_DEV_BYPASS
ENV NEXT_PUBLIC_ADMIN_DEV_BYPASS=$NEXT_PUBLIC_ADMIN_DEV_BYPASS
ARG NEXT_PUBLIC_ADMIN_DEV_ROLE
ENV NEXT_PUBLIC_ADMIN_DEV_ROLE=$NEXT_PUBLIC_ADMIN_DEV_ROLE
ARG NEXT_PUBLIC_ADMIN_DEV_NAME
ENV NEXT_PUBLIC_ADMIN_DEV_NAME=$NEXT_PUBLIC_ADMIN_DEV_NAME
ARG NEXT_PUBLIC_ADMIN_DEV_TOKEN
ENV NEXT_PUBLIC_ADMIN_DEV_TOKEN=$NEXT_PUBLIC_ADMIN_DEV_TOKEN
ARG NEXT_PUBLIC_OIDC_AUTHORITY
ENV NEXT_PUBLIC_OIDC_AUTHORITY=$NEXT_PUBLIC_OIDC_AUTHORITY
RUN npm run build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

EXPOSE 3000
CMD ["npm", "start"]
