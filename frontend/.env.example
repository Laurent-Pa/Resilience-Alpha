# Copier ce fichier en .env.local (gitignoré) et adapter les valeurs
# à votre environnement local.
#
#   cp .env.example .env.local

# URL de base de l'API payment-api. En local, correspond au port exposé
# par compose.dev.yaml (127.0.0.1:8001). En déploiement derrière le WAF,
# utiliser une URL relative ("/api/payments") puisque le routage se fait
# par chemin, sans réécriture (voir .claude/CLAUDE.md §7, §11).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/payments

# Realm Keycloak (client public web-pay). Derrière le WAF : https://192.168.137.1/auth/realms/resilience
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8080/auth/realms/resilience

# Base admin (back-office), même service payment-api, routes /admin/*.
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8001/api/admin

# --- Bypass de dev pour le back-office (TODO: retirer une fois Keycloak branché) ---
# Permet de visualiser /admin/* sans jeton réel pendant que l'intégration Keycloak
# côté front (CLAUDE.md §6) est en cours. Ne jamais activer hors local.
NEXT_PUBLIC_ADMIN_DEV_BYPASS=true
NEXT_PUBLIC_ADMIN_DEV_ROLE=ops
NEXT_PUBLIC_ADMIN_DEV_NAME=Compte de test (bypass)
# Si l'API exige déjà un Bearer valide, renseigner un jeton "operator" obtenu
# manuellement (ex: via Keycloak en direct) ; sinon laisser vide.
NEXT_PUBLIC_ADMIN_DEV_TOKEN=
