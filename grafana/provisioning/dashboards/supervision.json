      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Disponibilité du service (sonde)",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 28
