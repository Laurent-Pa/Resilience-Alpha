{
  "openapi": "3.1.0",
  "info": {
    "title": "payment-api",
    "description": "Virements idempotents entre comptes fictifs, ledger en partie double.",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/public-key": {
      "get": {
        "tags": [
          "payments"
        ],
        "summary": "Public Key",
        "description": "Clé publique RSA servant à chiffrer les coordonnées du bénéficiaire.\n\nÀ recharger si /payments/transfer répond 400 `decryption_failed` (clé renouvelée).",
        "operationId": "public_key_api_payments_public_key_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicKey"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/transfer": {
      "post": {
        "tags": [
          "payments"
        ],
        "summary": "Create Transfer",
        "operationId": "create_transfer_api_payments_transfer_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferEnvelope"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "200": {
            "description": "Rejeu identique : transaction existante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "description": "Coordonnées indéchiffrables",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Aucun compte associé à l'utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Même clé, requête différente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Fonds insuffisants, IBAN/BIC invalide ou inconnu, validation"
          }
        }
      }
    },
    "/api/payments": {
      "get": {
        "tags": [
          "payments"
        ],
        "summary": "List Payments",
        "description": "Historique : virements émis par l'utilisateur et reçus sur ses comptes.",
        "operationId": "list_payments_api_payments_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Payment"
                  },
                  "title": "Response List Payments Api Payments Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/{payment_id}": {
      "get": {
        "tags": [
          "payments"
        ],
        "summary": "Get Payment",
        "operationId": "get_payment_api_payments__payment_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "404": {
            "description": "Introuvable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/me": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "My Account",
        "description": "L'unique compte de l'utilisateur (un compte par personne).",
        "operationId": "my_account_api_accounts_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Aucun compte associé à cet utilisateur"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/admin/ledger/check": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Ledger Check",
        "description": "Invariant comptable : chaque transaction s'équilibre, a deux écritures, et aucun\ncompte client n'est négatif. Utilisé par le verifier du moteur de remédiation.",
        "operationId": "ledger_check_api_admin_ledger_check_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerCheck"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/admin/payments": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List All Payments",
        "description": "Vue back-office : les virements, tous émetteurs/destinataires confondus\n(contrairement à GET /payments, qui ne renvoie que l'historique de l'appelant).\n\nLe trafic de la sonde est écarté par défaut : elle émet un virement toutes les\nquelques secondes et noierait la liste. `include_prober=true` le réintègre.\n\nL'IBAN n'est jamais exposé qu'au format masqué (`AdminPayment.dst_iban_masked`,\nex. \"FR****8995\") : c'est la seule forme stockée en base, il n'y a donc rien\nà filtrer ici.",
        "operationId": "list_all_payments_api_admin_payments_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          },
          {
            "name": "include_prober",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Prober"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/prober/success-rate": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Prober Success Rate",
        "description": "SLI de la sonde : taux de réussite par minute sur la dernière heure complète.\n\nCalculé sur les virements réellement enregistrés, rapportés à la cadence nominale de\nla sonde (PROBER_INTERVAL_S). Une sonde arrêtée ou en échec n'écrit rien : ses\nminutes ressortent à 0 %, ce qui est le signal attendu.\n\nPas de log ici : le dashboard interroge cet endpoint en boucle.",
        "operationId": "prober_success_rate_api_admin_prober_success_rate_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProberSuccessRate"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/admin/assistant/ask": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Assistant Ask",
        "description": "Question à l'assistant documentaire (RAG), réservée au rôle ops.\n\nRelais vers rag-assistant sur le réseau Docker interne : l'assistant n'a pas\nd'authentification propre et n'est pas exposé par le WAF. Il répond à partir de\ndocs/exploitation/ en citant ses sources, et n'exécute aucune action.\n\nLa question n'est jamais journalisée (un opérateur peut y coller un message\nd'erreur) : seule sa longueur l'est.",
        "operationId": "assistant_ask_api_admin_assistant_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantQuestion"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantAnswer"
                }
              }
            }
          },
          "502": {
            "description": "Réponse de l'assistant hors contrat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Assistant (ou son LLM) indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Assistant trop lent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "iban_masked": {
            "type": "string",
            "title": "Iban Masked",
            "examples": [
              "FR****8995"
            ]
          },
          "bic": {
            "type": "string",
            "title": "Bic"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "balance": {
            "type": "string",
            "title": "Balance",
            "examples": [
              "1500.00"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "iban_masked",
          "bic",
          "label",
          "currency",
          "balance"
        ],
        "title": "Account"
      },
      "AdminPayment": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "src_account": {
            "type": "string",
            "format": "uuid",
            "title": "Src Account"
          },
          "dst_account": {
            "type": "string",
            "format": "uuid",
            "title": "Dst Account"
          },
          "dst_iban_masked": {
            "type": "string",
            "title": "Dst Iban Masked",
            "examples": [
              "FR****8995"
            ]
          },
          "amount": {
            "type": "string",
            "title": "Amount",
            "examples": [
              "50.05"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "REJECTED"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "initiated_by": {
            "type": "string",
            "enum": [
              "user",
              "prober"
            ],
            "title": "Initiated By"
          }
        },
        "type": "object",
        "required": [
          "id",
          "src_account",
          "dst_account",
          "dst_iban_masked",
          "amount",
          "status",
          "created_at",
          "initiated_by"
        ],
        "title": "AdminPayment",
        "description": "Vue back-office : ajoute l'origine de l'opération, sans intérêt pour le client\net donc absente de `Payment`."
      },
      "AssistantAnswer": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AssistantSource"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "sources"
        ],
        "title": "AssistantAnswer",
        "description": "Réponse de l'assistant, rédigée uniquement à partir de docs/exploitation/. Sans\npassage pertinent, `answer` le dit et `sources` est vide (ce n'est pas une erreur)."
      },
      "AssistantQuestion": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "description": "Question de l'opérateur ; un message d'erreur collé tel quel convient.",
            "examples": [
              "Que faire en cas de flood HTTP sur payment-api ?"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AssistantQuestion",
        "description": "Corps de POST /admin/assistant/ask. Mêmes bornes que AskRequest\n(contracts/rag-ask.schema.json) : rien de hors contrat n'est relayé."
      },
      "AssistantSource": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Titre du document (frontmatter `titre`)"
          },
          "file": {
            "type": "string",
            "title": "File",
            "description": "Chemin relatif à docs/exploitation/",
            "examples": [
              "runbooks/RB-01-flood-http.md"
            ]
          },
          "section": {
            "type": "string",
            "title": "Section",
            "description": "Chemin des titres du passage (h1 > h2 > h3)"
          }
        },
        "type": "object",
        "required": [
          "title",
          "file",
          "section"
        ],
        "title": "AssistantSource"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LedgerCheck": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "unbalanced_tx": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Unbalanced Tx"
          },
          "incomplete_tx": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Incomplete Tx"
          },
          "negative_accounts": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Negative Accounts"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "unbalanced_tx",
          "incomplete_tx",
          "negative_accounts"
        ],
        "title": "LedgerCheck"
      },
      "Payment": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "src_account": {
            "type": "string",
            "format": "uuid",
            "title": "Src Account"
          },
          "dst_account": {
            "type": "string",
            "format": "uuid",
            "title": "Dst Account"
          },
          "dst_iban_masked": {
            "type": "string",
            "title": "Dst Iban Masked",
            "examples": [
              "FR****8995"
            ]
          },
          "amount": {
            "type": "string",
            "title": "Amount",
            "examples": [
              "50.05"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "REJECTED"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "src_account",
          "dst_account",
          "dst_iban_masked",
          "amount",
          "status",
          "created_at"
        ],
        "title": "Payment"
      },
      "PaymentPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminPayment"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "PaymentPage",
        "description": "Page de résultats pour la vue admin (/admin/payments) : les virements, tous\németteurs/destinataires confondus, avec pagination."
      },
      "ProberMinute": {
        "properties": {
          "minute": {
            "type": "string",
            "format": "date-time",
            "title": "Minute",
            "description": "Début de la minute (UTC)"
          },
          "success_count": {
            "type": "integer",
            "title": "Success Count",
            "description": "Virements de la sonde réussis dans la minute"
          },
          "expected_count": {
            "type": "number",
            "title": "Expected Count",
            "description": "Virements attendus : 60 / intervalle de la sonde"
          },
          "success_pct": {
            "type": "number",
            "title": "Success Pct",
            "description": "Taux de réussite en %, plafonné à 100"
          }
        },
        "type": "object",
        "required": [
          "minute",
          "success_count",
          "expected_count",
          "success_pct"
        ],
        "title": "ProberMinute"
      },
      "ProberSuccessRate": {
        "properties": {
          "interval_s": {
            "type": "number",
            "title": "Interval S"
          },
          "window_minutes": {
            "type": "integer",
            "title": "Window Minutes"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ProberMinute"
            },
            "type": "array",
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "interval_s",
          "window_minutes",
          "points"
        ],
        "title": "ProberSuccessRate",
        "description": "SLI de la sonde : une entrée par minute complète, de la plus ancienne à la plus\nrécente. Le dénominateur suppose la cadence nominale de la sonde (`interval_s`)."
      },
      "PublicKey": {
        "properties": {
          "public_key": {
            "type": "string",
            "title": "Public Key",
            "description": "Clé publique RSA, PEM SubjectPublicKeyInfo"
          },
          "key_id": {
            "type": "string",
            "title": "Key Id",
            "description": "Empreinte de la clé ; change si la clé est renouvelée"
          },
          "algorithm": {
            "type": "string",
            "const": "RSA-OAEP-256",
            "title": "Algorithm"
          },
          "content_encryption": {
            "type": "string",
            "const": "A256GCM",
            "title": "Content Encryption"
          }
        },
        "type": "object",
        "required": [
          "public_key",
          "key_id",
          "algorithm",
