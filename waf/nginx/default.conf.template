# =====================================================================================
# WAF du PC Hôte : nginx + ModSecurity v3 + OWASP Core Rule Set (image owasp/modsecurity-crs).
# Seul service publié : 443 (hôte) → 8443 (conteneur, nginx non-root).
#
# Monté sur /etc/nginx/templates/conf.d/default.conf.template : l'entrypoint de l'image le
# recopie dans /etc/nginx/conf.d/ via envsubst, qui ne remplace que des variables
# d'ENVIRONNEMENT définies. Les $variables nginx ci-dessous restent intactes.
#
# Contrat de routage : docs/prod-interface.md §5.
# =====================================================================================

# Journal d'accès JSON (collecté par Loki à l'étape 5). $uri et non $request_uri :
# la query string n'est JAMAIS journalisée (jeton du flux SSE /api/remediation/events).
log_format waf_json escape=json
  '{"ts":"$time_iso8601","service":"waf","src_ip":"$remote_addr",'
  '"method":"$request_method","path":"$uri","status":$status,'
  '"bytes":$body_bytes_sent,"duration_s":$request_time,'
  '"upstream":"$upstream_addr","upstream_status":"$upstream_status",'
  '"trace_id":"$request_id","user_agent":"$http_user_agent"}';

# HTTP interne : sonde de santé du conteneur ; tout le reste repart en HTTPS.
# Ce port n'est pas publié sur l'hôte.
server {
    listen 8080 default_server;
    server_name _;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # proxy_protocol : chaque connexion arrive du proxy L4 Windows (edge/nginx.conf), qui
    # transmet l'IP réelle du client dans un en-tête PROXY protocol avant le flux TLS.
    # Une connexion sans cet en-tête est refusée : le WAF n'est joignable que via ce relais
    # (port publié uniquement sur 127.0.0.1 du PC Hôte).
    listen 8443 ssl proxy_protocol default_server;
    server_name _;
    server_tokens off;

    # IP réelle du client → $remote_addr (journal, ModSecurity, X-Forwarded-For, block_ip).
    # Docker Desktop fait apparaître toute connexion publiée comme venant de la passerelle
    # du réseau Docker : on ne fait confiance à l'en-tête PROXY que depuis ces relais-là.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.65.0/24;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    # Liste de blocage alimentée par le moteur de remédiation (block_ip.yml : deny <ip>; + reload).
    # Glob vide au démarrage = aucune règle, nginx l'accepte.
    include /etc/nginx/denylist/*.conf;

    ssl_certificate     /etc/nginx/certs/waf.crt;
    ssl_certificate_key /etc/nginx/certs/waf.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # ModSecurity + CRS : déjà activés au niveau http par l'image (conf.d/modsecurity.conf :
    # modsecurity on + /etc/modsecurity.d/setup.conf). NE PAS les redéclarer ici (règles
    # chargées deux fois = identifiants en double). Mode : MODSEC_RULE_ENGINE du compose.

    # Sonde de santé de l'image (HEALTHCHECK sur /healthz).
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    access_log /dev/stdout waf_json;
    client_max_body_size 1m;
    large_client_header_buffers 4 32k;

    # Résolution DNS Docker À LA REQUÊTE (et non au démarrage) : le WAF démarre même si un
    # service est arrêté, et suit l'IP d'un conteneur recréé par la remédiation.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $frontend    http://frontend:3000;
    set $payment_api http://payment-api:8000;
    set $remediation http://remediation-engine:8000;
    set $keycloak    http://keycloak:8080;

    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    # IP source : on ÉCRASE ce que le client envoie. Un X-Forwarded-For fourni par
    # l'attaquant ferait accuser (et bloquer par block_ip) une autre adresse.
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  443;
    # Identifiant de corrélation : devient le trace_id des services.
    proxy_set_header X-Request-ID      $request_id;
    add_header       X-Request-ID      $request_id always;

    # --- Jamais publiés : sondes techniques et entrée des alertes du moteur ---------------
    location ~ ^/api/remediation/(alerts|metrics|health)(/|$) {
        return 404;
    }
    # Console et API d'administration Keycloak : interface de gestion, non exposée.
    location ^~ /auth/admin {
        return 403;
    }

    # --- payment-api : sans réécriture de chemin -----------------------------------------
    location ~ ^/api/(payments|accounts|admin)(/|$) {
        proxy_pass $payment_api;
    }

    # --- remediation-engine : préfixe /api/remediation retiré ----------------------------
    # Flux SSE : ni mise en tampon, ni inspection ModSecurity (qui retiendrait la réponse).
    location = /api/remediation/events {
        modsecurity off;
        rewrite ^/api/remediation/(.*)$ /$1 break;
        proxy_pass $remediation;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
    location /api/remediation/ {
        rewrite ^/api/remediation/(.*)$ /$1 break;
        proxy_pass $remediation;
    }

    # --- Keycloak (KC_HTTP_RELATIVE_PATH=/auth) : en-têtes et cookies volumineux ----------
    location /auth {
        proxy_pass $keycloak;
        proxy_buffer_size       128k;
        proxy_buffers           4 256k;
        proxy_busy_buffers_size 256k;
    }

    # --- Frontend (paiement + /admin) -------------------------------------------------
    location / {
        proxy_pass $frontend;
    }
}
